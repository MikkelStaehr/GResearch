# Postgres-forbindelse til Supabase (session pooler). Bruges direkte via pg; velo er ikke eksponeret i API'et.
DATABASE_URL=

# Valgfrit: sti til Supabase' CA-certifikat (Dashboard → Database → SSL Configuration → Download certificate).
# Med den verificeres databasens certifikat; uden den følger pg sslmode i DATABASE_URL.
DATABASE_CA_CERT=

# Supabase-projektet (ikke brugt af scraperen i dag, men hører til projektet).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# FlareSolverr på DigitalOcean-VM'en, fx http://localhost:8191
FLARESOLVERR_URL=

# Valgfrit: pause mellem opslag i sekunder (tilfældig mellem min og max). Standard 5-10.
PCS_DELAY_MIN_S=
PCS_DELAY_MAX_S=

# Valgfrit: ventetid i sekunder efter Cloudflare-side eller FlareSolverr-fejl. Standard 300.
PCS_FAILURE_WAIT_S=
